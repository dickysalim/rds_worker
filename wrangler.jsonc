{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rds-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rds_factory_management",
      "database_id": "40ee5539-cafa-49c2-a4cb-a70ced75a37a",
      "migrations_dir": "migrations"
    }
  ]
}
